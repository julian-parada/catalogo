# Cabeceras de seguridad para Cloudflare Pages (se aplican a todas las páginas)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Estilos y scripts: publicar.sh les pone ?v=<versión> en cada cambio, así que pueden guardarse 1 año
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
# Imágenes y logos propios: 1 semana
/img/*
  Cache-Control: public, max-age=604800
/favicon*
  Cache-Control: public, max-age=604800
/icon-*
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# El panel y las páginas de contraseña no se guardan en caché ni aparecen en Google
/admin*
  Cache-Control: no-store
  X-Robots-Tag: noindex
/ajustes*
  Cache-Control: no-store
  X-Robots-Tag: noindex
/agregarPrenda*
  X-Robots-Tag: noindex
/editarPrenda*
  X-Robots-Tag: noindex
/restablecer*
  Cache-Control: no-store
  X-Robots-Tag: noindex
/plataforma*
  Cache-Control: no-store
  X-Robots-Tag: noindex
